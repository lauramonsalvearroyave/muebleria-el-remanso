rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/team/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/team/$(request.auth.uid)).data.role == 'admin';
    }

    function isColaborador() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/team/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/team/$(request.auth.uid)).data.role == 'colaborador';
    }

    // Comentarios de clientes.
    // Cualquiera puede enviar el suyo, pero entra SIN publicar y nadie de
    // fuera puede publicarlo: aprobar es cosa del panel.
    match /testimonials/{id} {

      // El sitio público solo alcanza los aprobados.
      // Un administrador ve todos, incluidos los pendientes.
      allow read: if resource.data.published == true
                  || isAdmin();

      // Enviar un comentario: sin sesión, pero con condiciones.
      allow create: if request.resource.data.published == false
                    && request.resource.data.consent == true
                    && request.resource.data.quote is string
                    && request.resource.data.quote.size() > 0
                    && request.resource.data.quote.size() < 2000
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 120
                    && request.resource.data.keys().hasOnly([
                         'name', 'city', 'stage', 'piece', 'quote',
                         'consent', 'order', 'published', 'createdAt'
                       ]);

      // Aprobar, ocultar, editar o borrar: solo un administrador.
      allow update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isColaborador() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl','imagePath','soldOut','featured','isNew'])
      );
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || isColaborador();
      allow create: if isAdmin() || isColaborador();
      allow update, delete: if isAdmin();

      match /purchases/{purchaseId} {
        allow read: if isAdmin() || isColaborador();
        allow create: if isAdmin() || isColaborador();
        allow update, delete: if isAdmin();
      }
    }

    // Pedidos. Coleccion propia y no subcoleccion del cliente, para poder
    // listarlos todos y filtrar por estado desde la pestana Pedidos.
    // Nunca se leen desde el sitio publico: solo el panel.
    match /orders/{orderId} {
      allow read:   if isAdmin() || isColaborador();
      allow create: if isAdmin() || isColaborador();
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid && request.resource.data.role == 'colaborador'
                    && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
                    && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }

    match /invites/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if request.auth != null && resource.data.used == false && request.resource.data.used == true && request.resource.data.usedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
